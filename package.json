{
  "name": "catedra-static",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:export": "node scripts/check-export.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "npm test && npm run build && npm run typecheck && npm run check:export"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
