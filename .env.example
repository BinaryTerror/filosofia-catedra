# Demo visual: não usa base de dados, não permite gerir publicações.
DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Supabase: ligação Session pooler, porta 5432, com SSL.
DATABASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=catedra-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# https://PROJECT.supabase.co/storage/v1/object/public/catedra-media
MEDIA_PUBLIC_URL=
# Apenas para executar npm run bootstrap; remover depois.
ADMIN_EMAIL=
ADMIN_PASSWORD=
